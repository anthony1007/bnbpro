datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            Int       @id @default(autoincrement())
  walletAddress String    @unique
  refCode       String    @unique

  name          String?
  avatar        String?
  language      String?

  referrerId    Int?
  referrer      User?     @relation("UserReferrals", fields: [referrerId], references: [id])
  referrals     User[]    @relation("UserReferrals")

  role          Role      @default(USER)
  balance       Decimal   @default(0) @db.Decimal(36, 18)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  deposits      Deposit[]
  withdrawals   Withdrawal[]
  fundPurchases FundPurchase[]
  commissions   Commission[]
  tickets       SupportTicket[]
  claims        ClaimHistory[]
  transactions  Transaction[]
}

model Fund {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  minAmount    Decimal   @db.Decimal(36, 18)
  dailyRate    Decimal   @db.Decimal(10, 4)  // %/day, ví dụ 1.5 = 1.5%
  durationDays Int
  isActive     Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  purchases    FundPurchase[]
}

model FundPurchase {
  id           Int       @id @default(autoincrement())
  userId       Int
  fundId       Int
  amount       Decimal   @db.Decimal(36, 18)

  // Snapshot thông số gói tại thời điểm mua
  dailyRate    Decimal   @db.Decimal(10, 4)
  durationDays Int

  startAt      DateTime
  endAt        DateTime
  lastClaimAt  DateTime
  totalClaimed Decimal   @default(0) @db.Decimal(36, 18)

  status       String    @default("ACTIVE") // ACTIVE | COMPLETED

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id])
  fund         Fund      @relation(fields: [fundId], references: [id])
  claims       ClaimHistory[]
}

model ClaimHistory {
  id             Int       @id @default(autoincrement())
  userId         Int
  fundPurchaseId Int
  amount         Decimal   @db.Decimal(36, 18)
  createdAt      DateTime  @default(now())

  user           User         @relation(fields: [userId], references: [id])
  fundPurchase   FundPurchase @relation(fields: [fundPurchaseId], references: [id])
}

model Deposit {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Decimal  @db.Decimal(36, 18)
  txHash    String?  @unique
  status    String   // PENDING | SUCCESS | FAILED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model Withdrawal {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Decimal  @db.Decimal(36, 18)
  toAddress String
  txHash    String?
  status    String   // PROCESSING | SUCCESS | FAILED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model Commission {
  id          Int      @id @default(autoincrement())
  userId      Int      // người nhận hoa hồng
  fromUserId  Int      // tuyến dưới tạo doanh số
  level       Int      // 1 / 2 / 3
  percent     Decimal  @db.Decimal(10, 4) // 6 / 3 / 1
  amount      Decimal  @db.Decimal(36, 18)
  sourceType  String   // "DEPOSIT" | "PURCHASE"
  createdAt   DateTime @default(now())

  user        User     @relation("CommissionReceiver", fields: [userId], references: [id])
  fromUser    User     @relation("CommissionSource", fields: [fromUserId], references: [id])
}

model SupportTicket {
  id        Int             @id @default(autoincrement())
  userId    Int
  title     String
  status    String          @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user      User            @relation(fields: [userId], references: [id])
  messages  SupportMessage[]
}

model SupportMessage {
  id        Int            @id @default(autoincrement())
  ticketId  Int
  sender    String         // "USER" | "SYSTEM" | sau này thêm "ADMIN" nếu cần
  message   String
  createdAt DateTime       @default(now())

  ticket    SupportTicket  @relation(fields: [ticketId], references: [id])
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // "DEPOSIT" | "WITHDRAW" | "CLAIM" | "COMMISSION" | "PURCHASE"
  amount    Decimal  @db.Decimal(36, 18)
  txHash    String?
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}
